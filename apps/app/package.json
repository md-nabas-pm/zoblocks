{
  "name": "@zoblocks/app",
  "version": "0.1.0",
  "private": true,
  "description": "Theme management for enterprise customers: author a design language, validate it against the same gate the build uses, publish it as an immutable stylesheet.",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 6003",
    "build": "next build",
    "start": "next start --port 6003",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:indexes": "tsx scripts/ensure-indexes.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "db:seed": "tsx scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:server": "tsx scripts/e2e-server.mjs",
    "db:seed:market": "tsx scripts/seed-market.mjs",
    "stripe:sync": "tsx scripts/stripe-sync.mjs",
    "db:bootstrap": "tsx scripts/bootstrap-org.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.3.1",
    "@zoblocks/bridge-antd": "workspace:*",
    "@zoblocks/bridge-core": "workspace:*",
    "@zoblocks/bridge-mui": "workspace:*",
    "@zoblocks/cli": "workspace:*",
    "@zoblocks/copilot-react": "workspace:*",
    "@zoblocks/react": "workspace:*",
    "@zoblocks/theme": "workspace:*",
    "@zoblocks/tokens": "workspace:*",
    "antd": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.4.0",
    "next": "~16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@zoblocks/tsconfig": "workspace:*",
    "mongodb-memory-server": "^10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
