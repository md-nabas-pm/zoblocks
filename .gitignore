# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
build/
*.tsbuildinfo

# turbo
.turbo/

# Registry payloads inline the full source of every component, so committing
# them would put each component's source in the diff twice. Rebuilt by
# `pnpm gen`. The manifest (registry.json) and the other generated artifacts
# ARE committed, and CI fails if they are stale.
apps/docs/public/r/*.json
# The agent manifest (ADR 0017) inlines the whole catalog for the same reason.
apps/docs/public/ai/*.json

# env & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# test output
coverage/
playwright-report/
test-results/

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.vercel

# mongod binary for hq's tests (see MONGOMS_DOWNLOAD_DIR in ci.yml)
.cache/
