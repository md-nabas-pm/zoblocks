{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `registry/` is an input even though it lives outside every package.
      //
      // The docs app imports the registry directly — component sources through
      // `@/registry/*`, and every component stylesheet through an `@import` in
      // globals.css. Neither is inside `apps/docs` and neither belongs to a
      // workspace package it depends on, so the default hash could not see
      // them: editing a component's CSS left the docs build a cache hit and
      // the site kept serving the previous stylesheet.
      //
      // That is a bad failure to have. It looks like the change had no effect,
      // so the next move is to change something else — and the browser suite
      // spent three rounds failing against a build that predated the fix it
      // was testing.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/registry/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // Builds workspace dependencies first, like every other task here. The docs
    // app aliases the NodeNext packages (tabs, consult) to their `dist` — see
    // apps/docs/next.config.ts — so without a build those specifiers resolve
    // into `src`, hit a `./Tabs.js` import that only Node can follow, and the
    // whole site 500s. The error names a file that exists on disk, which makes
    // it read as a broken component rather than a missing build.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Never cached. The build bundles apps/docs/public/ai/manifest.json — a
    // generated, gitignored file outside the package — so the default hash
    // cannot see a catalog change, and a cache hit would restore a dist whose
    // bundled catalog is stale. That snapshot is what `--offline` and every
    // unreachable-network start serve. tsc on this package takes a second.
    "@zoblocks/mcp#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // No artefacts. `test` runs `vitest run`; only `test:coverage` passes
      // --coverage, so declaring coverage/** here made turbo warn on every
      // package whose suite produced nothing — noise on each CI run, and the
      // kind that trains people to skim past warnings.
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
