{
  "name": "zoblocks",
  "version": "0.0.0",
  "private": true,
  "description": "Healthcare UI components with FHIR-shaped data contracts, delivered as source through the ZoBlocks registry.",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "a11y": "tsx scripts/a11y.ts",
    "build": "turbo run build",
    "changeset": "changeset",
    "conformance": "tsx scripts/conformance.ts",
    "deps": "depcruise --config .dependency-cruiser.cjs packages registry scripts --output-type err",
    "dev": "turbo run dev",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --grep-invert @vrt",
    "e2e:update": "playwright test --grep @vrt --update-snapshots",
    "e2e:vrt": "playwright test --grep @vrt",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "gen": "tsx scripts/gen/index.ts",
    "gen:check": "tsx scripts/gen/index.ts --check",
    "gen:component": "tsx scripts/gen/scaffold.ts",
    "gen:strict": "tsx scripts/gen/index.ts --strict",
    "icons": "tsx scripts/icons.ts",
    "lint": "eslint . --max-warnings 0 && pnpm lint:actions",
    "lint:actions": "bash scripts/actionlint.sh",
    "lint:fix": "eslint . --fix",
    "check:names": "bash scripts/retired-names.sh",
    "prepare": "husky",
    "publint": "pnpm -r --filter \"./packages/*\" --filter \"!@zoblocks/component-meta\" --filter \"!@zoblocks/eslint-plugin\" --filter \"!@zoblocks/figma-plugin\" --filter \"!@zoblocks/fixtures\" --filter \"!@zoblocks/tsconfig\" exec publint --strict",
    "registry:build": "tsx scripts/gen/index.ts",
    "registry:check": "tsx scripts/gen/index.ts --check",
    "release": "turbo run build && node scripts/check-tarball.mjs && changeset publish",
    "release:check": "node scripts/check-tarball.mjs",
    "size": "size-limit",
    "test": "turbo run test && pnpm test:registry",
    "test:coverage": "turbo run test:coverage && vitest run --coverage",
    "test:registry": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "verify": "bash scripts/verify.sh",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/cli": "^4.12.1",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@zoblocks/cli": "workspace:*",
    "@zoblocks/clinical-note-core": "workspace:*",
    "@zoblocks/component-meta": "workspace:*",
    "@zoblocks/copilot-core": "workspace:*",
    "@zoblocks/copilot-react": "workspace:*",
    "@zoblocks/eslint-plugin": "workspace:^",
    "@zoblocks/fhir": "workspace:*",
    "@zoblocks/fixtures": "workspace:*",
    "@zoblocks/identity": "workspace:*",
    "@zoblocks/recorder-core": "workspace:*",
    "@zoblocks/theme": "workspace:*",
    "@zoblocks/tokens": "workspace:*",
    "axe-core": "^4.13.0",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30",
    "lint-staged": "^17.3.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^13.0.3",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.23.12",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "//overrides": "Transitive advisories we cannot reach through a direct dependency. Each entry is the patched floor from the advisory, not a pin — remove it once the parent package ships the fix itself. `pnpm audit --audit-level=high` in CI is what tells us when that has happened.",
    "overrides": {
      "nanoid@<3.3.18": ">=3.3.18",
      "fast-uri@<3.1.6": ">=3.1.6 <4",
      "js-yaml@<4.3.2": ">=4.3.2",
      "devalue@<5.9.1": ">=5.9.2",
      "undici@>=8.1.0 <8.10.2": ">=8.10.2",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2",
      "undici@>=8.10.0 <8.10.2": ">=8.10.2",
      "fast-uri@>=3.0.0 <3.1.8": ">=3.1.8",
      "ip-address@<=10.7.0": ">=10.7.1",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "next@<16.3.8": ">=16.3.8",
      "basic-ftp@<=6.2.0": ">=6.2.1",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "@vue/server-renderer@<3.5.42": ">=3.5.42",
      "prosemirror-view@<1.42.3": ">=1.42.3",
      "sharp@<0.35.5": ">=0.35.5",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0"
    },
    "//auditConfig": "Advisories with no patched release, ignored by GHSA so a new advisory on the same package still fails CI. GHSA-vfj7-8cjw-p6xm (braces <=3.0.3, no fix published): reached only through the dev-only @next/eslint-plugin-next > fast-glob > micromatch, which expands this repo's own lint globs, never untrusted patterns. Remove once braces ships a fix or the plugin drops fast-glob 3.",
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "lint-staged": {
    "//": "--no-warn-ignored because lint-staged passes every staged file matching the glob, including generated artifacts that .eslintignore excludes. ESLint then warns 'File ignored because of a matching ignore pattern', and --max-warnings 0 turns that warning into a failed commit — so staging a regenerated catalog.ts or next-env.d.ts blocked the commit for a file nobody is meant to lint.",
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2"
  }
}
